# Configuración de Base de Datos PostgreSQL
#
# La contraseña REAL vive únicamente acá, en tu archivo .env local (ignorado por git).
# En application.yml el default es solo un placeholder no funcional
# (${DB_PASSWORD:postgres_local_dev_password}); nunca pongas la contraseña real ahí.
#
# Para desarrollo local con el docker-compose.yml del repo:
#   DB_URL=jdbc:postgresql://localhost:5433/eventfoto_db
#   DB_USER=postgres
#   DB_PASSWORD=postgres_local_dev_password   (la que fija docker-compose.yml)
#
# Valores de ejemplo para Railway:
DB_URL=jdbc:postgresql://postgres.railway.internal:5432/railway
DB_USER=postgres
DB_PASSWORD=tu_contraseña_railway_postgres

# Configuración de Storage Cloudflare R2 (S3 API)
R2_ACCESS_KEY=tu_r2_access_key_id
R2_SECRET_KEY=tu_r2_secret_access_key
R2_BUCKET=event-foto
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Seguridad JWT y credenciales del superadmin (fase 9.1 Bloque 1: el login del
# organizador ya no usa variables de entorno, se valida contra la tabla organizer).
# OJO: estos son valores de EJEMPLO públicos. Con STORAGE_MODE=r2 (producción) la app
# NO arranca si SUPERADMIN_EMAIL, SUPERADMIN_PASSWORD o JWT_SECRET (o DB_PASSWORD / R2_*)
# quedan con estos valores.
SUPERADMIN_EMAIL=superadmin@eventfoto.com.ar
SUPERADMIN_PASSWORD=admin123
# Opcional, default 7200000 (2 horas) -- sesión de superadmin corta a propósito: no
# tiene tokenVersion en BD que comparar, así que la expiración es su única defensa.
SUPERADMIN_JWT_EXPIRATION_MS=7200000
JWT_SECRET=super_secret_jwt_key_minimo_32_caracteres_123456

# URL pública de la app, sin barra final. Única fuente de toda URL absoluta que genera
# la app (el QR que se imprime para las mesas, el link del panel). No se deriva del host
# de la request. Con STORAGE_MODE=r2 la app NO arranca si apunta a localhost.
# Local: http://localhost:8080 (default si no la seteás)
# Producción hoy: el dominio de Railway. Mudanza a eventfoto.com.ar: ver README,
# sección "Mudanza de dominio".
APP_BASE_URL=https://tu-dominio.up.railway.app

# Checkout con Mercado Pago (fase 9.3). Apagado por defecto: sin rutas y sin credenciales.
# Con CHECKOUT_ENABLED=true hace falta MP_ACCESS_TOKEN (de PRUEBA hasta la L6; nunca producción).
CHECKOUT_ENABLED=false
MP_ACCESS_TOKEN=
CHECKOUT_PRICE_ARS=50000
# Fase 9.4: clave secreta de Webhooks del panel de MP (valida x-signature). Obligatoria con CHECKOUT_ENABLED=true.
# En la L6 cambia junto con el access token: la de producción es otro valor.
MP_WEBHOOK_SECRET=
# WhatsApp de contacto (solo dígitos, con código de país) para un pago que queda en revisión manual.
SUPPORT_WHATSAPP=

# Puerto de Ejecución (Railway setea este puerto automáticamente)
PORT=8080

# Observabilidad de errores (Sentry) — opcional en desarrollo, recomendado en producción.
# Vacío desactiva Sentry (modo no-op, no rompe nada si no lo configurás).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
