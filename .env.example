# Configuración de Base de Datos PostgreSQL
#
# La contraseña REAL vive únicamente acá, en tu archivo .env local (ignorado por git).
# En application.yml el default es solo un placeholder no funcional
# (${DB_PASSWORD:postgres_local_dev_password}); nunca pongas la contraseña real ahí.
#
# Para desarrollo local con el docker-compose.yml del repo:
#   DB_URL=jdbc:postgresql://localhost:5433/eventfoto_db
#   DB_USER=postgres
#   DB_PASSWORD=postgres_local_dev_password   (la que fija docker-compose.yml)
#
# Valores de ejemplo para Railway:
DB_URL=jdbc:postgresql://postgres.railway.internal:5432/railway
DB_USER=postgres
DB_PASSWORD=tu_contraseña_railway_postgres

# Configuración de Storage Cloudflare R2 (S3 API)
R2_ACCESS_KEY=tu_r2_access_key_id
R2_SECRET_KEY=tu_r2_secret_access_key
R2_BUCKET=boda-marcos-y-priscila
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Seguridad JWT y Credenciales del Panel de Administración
ADMIN_EMAIL=admin@boda.com
ADMIN_PASSWORD=admin123
JWT_SECRET=super_secret_jwt_key_minimo_32_caracteres_123456

# URL pública de la app, sin barra final. Única fuente de toda URL absoluta que genera
# la app (el QR que se imprime para las mesas, el link del panel). No se deriva del host
# de la request. Con STORAGE_MODE=r2 la app NO arranca si apunta a localhost.
# Local: http://localhost:8080 (default si no la seteás)
# Producción hoy: el dominio de Railway. Mudanza a eventfoto.com.ar: ver README,
# sección "Mudanza de dominio".
APP_BASE_URL=https://marcosypriscila-production.up.railway.app

# Puerto de Ejecución (Railway setea este puerto automáticamente)
PORT=8080

# Observabilidad de errores (Sentry) — opcional en desarrollo, recomendado en producción.
# Vacío desactiva Sentry (modo no-op, no rompe nada si no lo configurás).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
